# ACS FSM backend environment example.
# Use production secret storage or server environment variables for real deployments.

ACS_FSM_ENVIRONMENT=development
ACS_FSM_LOG_LEVEL=INFO
ACS_FSM_LOG_FORMAT=json
ACS_FSM_API_V1_PREFIX=/api/v1
ACS_FSM_API_DOCS_ENABLED=true
ACS_FSM_PROXY_ROOT_PATH=
ACS_FSM_CORS_ALLOWED_ORIGINS=["https://app.applecleaningsystems.net"]
ACS_FSM_REQUEST_ID_HEADER=X-Request-ID
# Local development example only. Do not reuse for production.
ACS_FSM_DATABASE_URL=postgresql+psycopg://acs_fsm_dev:acs_fsm_dev@127.0.0.1:5432/acs_fsm_dev
ACS_FSM_DATABASE_ECHO=false
ACS_FSM_DATABASE_POOL_PRE_PING=true

# Future auth provider placeholders only. Module 52 keeps auth disabled and
# does not implement token verification, sessions, login, logout, or RBAC.
# Supply real values later through secure runtime environment management only.
ACS_FSM_AUTH_PROVIDER=disabled
ACS_FSM_AUTH_ENABLED=false
ACS_FSM_AUTH_ISSUER_URL=
ACS_FSM_AUTH_AUDIENCE=
ACS_FSM_AUTH_JWKS_URL=
ACS_FSM_AUTH_ALLOWED_EMAIL_DOMAINS=
ACS_FSM_AUTH_REQUIRE_VERIFIED_EMAIL=true
ACS_FSM_AUTH_LOCAL_DEV_MODE=false
ACS_FSM_AUTH_ROLE_CLAIM=
ACS_FSM_AUTH_PERMISSION_CLAIM=
