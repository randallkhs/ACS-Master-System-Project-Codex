# Backend base URL for server-side dashboard API calls.
#
# Local full-stack development:
# ACS_DASHBOARD_API_BASE_URL=http://127.0.0.1:8000
#
# Production deployment should set an environment-specific HTTPS backend origin.
# Do not hardcode localhost for production and do not commit secrets.
# Example:
# ACS_DASHBOARD_API_BASE_URL=https://api.applecleaningsystems.net
ACS_DASHBOARD_API_BASE_URL=
